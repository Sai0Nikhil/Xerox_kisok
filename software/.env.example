# Bittu Xerox Kiosk — Environment Configuration
# Copy this to .env and fill in real values

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ── Payment (Razorpay) ──
RAZORPAY_KEY_ID=your_key
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── UPI (for direct QR) ──
UPI_VPA=yourname@upi
UPI_MERCHANT_NAME=Bittu Xerox Kiosk

# ── Paths ──
SPOOL_DIR=/tmp/kiosk_spool
DB_PATH=/data/bittu.db
LOGO_PATH=/opt/bittu/assets/klu_logo.png

# ── Server ──
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── Kiosk Identity (for fleet management) ──
KIOSK_ID=KLU-H1
KIOSK_LOCATION=KLU Boys Hostel Block 1

# ── Cloud Backend (for hybrid mode) ──
# CLOUD_API_URL=https://api.bittuxerox.in
# CLOUD_API_KEY=your_cloud_key

# ── Limits ──
MAX_FILE_SIZE_MB=50
MAX_COPIES=20
OTP_TTL_MINUTES=120
OTP_MAX_ATTEMPTS=3

# ── Pricing ──
PRICE_PER_PAGE_BW=2.50
PRICE_LOGO_STAMP_EXTRA=1.00
